# StockSense IMS - Backend Environment Variables
# Copy this file to .env and fill in the values. Never commit .env.

PORT=5001
NODE_ENV=development

# Frontend URL(s) allowed by CORS. Comma-separate several, e.g. local + deployed.
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------
# MySQL (run database/schema.sql and database/seed.sql first)
# -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stocksense

# -------------------------------------------------------------
# Auth
# -------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
OTP_EXPIRY_MINUTES=10

# -------------------------------------------------------------
# SMTP Mailer Configuration (Nodemailer)
# -------------------------------------------------------------
# If SMTP_USER and SMTP_PASS are empty (development only), Nodemailer creates an
# Ethereal test inbox and returns a preview link instead of sending real email.

# Gmail SMTP (needs a 16-character Google App Password)
# 1. Enable 2-Step Verification in your Google Account
# 2. Security -> App Passwords -> create one for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense IMS <no-reply@stocksense.app>"
